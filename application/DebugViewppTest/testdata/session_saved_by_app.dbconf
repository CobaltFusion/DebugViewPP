<?xml version="1.0" encoding="utf-8"?>
<DebugViewPP>
	<AutoNewline>false</AutoNewline>
	<LinkViews>true</LinkViews>
	<Views>
		<View>
			<Index>0</Index>
			<Name>Errors</Name>
			<ClockTime>true</ClockTime>
			<ProcessColors>false</ProcessColors>
			<MessageFilters>
				<Filter>
					<Enable>true</Enable>
					<Text>error</Text>
					<MatchType>Simple</MatchType>
					<FilterType>Include</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>255</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>noise.*</Text>
					<MatchType>Regex</MatchType>
					<FilterType>Exclude</FilterType>
					<BackColor>
						<Red>1</Red>
						<Green>2</Green>
						<Blue>3</Blue>
					</BackColor>
					<TextColor>
						<Red>4</Red>
						<Green>5</Green>
						<Blue>6</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>false</Enable>
					<Text>a &amp; b &lt;c&gt; &quot;quoted&quot; &apos;single&apos;</Text>
					<MatchType>Wildcard</MatchType>
					<FilterType>Highlight</FilterType>
					<BackColor>
						<Red>250</Red>
						<Green>240</Green>
						<Blue>200</Blue>
					</BackColor>
					<TextColor>
						<Red>10</Red>
						<Green>20</Green>
						<Blue>30</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>id=(\d+)</Text>
					<MatchType>RegexGroups</MatchType>
					<FilterType>Token</FilterType>
					<BackColor Auto="true"/>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>CaseSensitive</Text>
					<MatchType>RegexCase</MatchType>
					<FilterType>Track</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>0</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>fatal</Text>
					<MatchType>Simple</MatchType>
					<FilterType>Stop</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</BackColor>
					<TextColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>255</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>first only</Text>
					<MatchType>Simple</MatchType>
					<FilterType>Once</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>255</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>DBGVIEWCLEAR</Text>
					<MatchType>Simple</MatchType>
					<FilterType>Clear</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>255</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>beep</Text>
					<MatchType>Simple</MatchType>
					<FilterType>Beep</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>255</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>bookmark me</Text>
					<MatchType>Simple</MatchType>
					<FilterType>Bookmark</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>255</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
			</MessageFilters>
			<ProcessFilters>
				<Filter>
					<Enable>true</Enable>
					<Text>app.exe</Text>
					<MatchType>Simple</MatchType>
					<FilterType>Include</FilterType>
					<BackColor>
						<Red>255</Red>
						<Green>255</Green>
						<Blue>255</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
				<Filter>
					<Enable>true</Enable>
					<Text>helper</Text>
					<MatchType>Wildcard</MatchType>
					<FilterType>Highlight</FilterType>
					<BackColor>
						<Red>200</Red>
						<Green>220</Green>
						<Blue>255</Blue>
					</BackColor>
					<TextColor>
						<Red>0</Red>
						<Green>0</Green>
						<Blue>0</Blue>
					</TextColor>
				</Filter>
			</ProcessFilters>
			<Columns>
				<Column>
					<Index>0</Index>
					<Enable>true</Enable>
					<Width>20</Width>
					<Order>0</Order>
				</Column>
				<Column>
					<Index>1</Index>
					<Enable>true</Enable>
					<Width>111</Width>
					<Order>1</Order>
				</Column>
				<Column>
					<Index>2</Index>
